generator client {
  provider        = "prisma-client"
  output          = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  tier          String    @default("free")
  createdAt     DateTime  @default(now())
  accounts      Account[]
  sessions      Session[]
  preference    UserPreference?
  appleCalendar AppleCalendar?
}

model AppleCalendar {
  id              String  @id @default(cuid())
  userId          String  @unique
  appleId         String
  appPassword     String
  calendarUrl     String  @default("https://caldav.icloud.com")
  enabled         Boolean @default(true)
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model RateLimit {
  id        String   @id @default(cuid())
  key       String
  timestamp DateTime @default(now())

  @@index([key, timestamp])
}

model RecurringEvent {
  id          String   @id @default(cuid())
  userId      String
  title       String
  startTime   String   // HH:mm format
  endTime     String   // HH:mm format
  location    String?
  description String?
  category    String   @default("other")
  color       String   @default("blue")
  priority    String   @default("medium")
  rrule       String   // RRULE string (e.g., "FREQ=WEEKLY;BYDAY=MO,WE,FR")
  startDate   DateTime // First occurrence
  endDate     DateTime? // Optional end date for the recurrence
  exceptions  String[] // ISO dates to skip (deleted instances)
  createdAt   DateTime @default(now())

  @@index([userId])
}

model UserPreference {
  id                     String  @id @default(cuid())
  userId                 String  @unique
  defaultReminderMinutes Int     @default(30)
  defaultEventDuration   Int     @default(60)
  morningBriefingTime    String  @default("08:00")
  timezone               String  @default("UTC")
  workingHoursStart      String  @default("09:00")
  workingHoursEnd        String  @default("18:00")
  defaultCalendarView    String  @default("month")
  user                   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}
