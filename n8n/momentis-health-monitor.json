{
  "name": "Momentis — Health Monitor",
  "nodes": [
    {
      "id": "schedule",
      "name": "Every 15 Min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "position": [200, 300],
      "typeVersion": 1.3,
      "parameters": {
        "rule": {
          "interval": [{ "field": "minutes", "minutesInterval": 15 }]
        }
      }
    },
    {
      "id": "health-req",
      "name": "Health Check",
      "type": "n8n-nodes-base.httpRequest",
      "position": [420, 300],
      "typeVersion": 4.4,
      "onError": "continueRegularOutput",
      "parameters": {
        "method": "GET",
        "url": "https://YOUR_APP.vercel.app/api/health",
        "options": {
          "timeout": 8000,
          "response": {
            "response": { "responseFormat": "json" }
          }
        }
      }
    },
    {
      "id": "is-ok",
      "name": "Is Healthy?",
      "type": "n8n-nodes-base.if",
      "position": [640, 300],
      "typeVersion": 2.3,
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.status }}",
              "rightValue": "ok",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "all-good",
      "name": "All Good ✅",
      "type": "n8n-nodes-base.noOp",
      "position": [860, 200],
      "parameters": {}
    },
    {
      "id": "alert",
      "name": "Build Alert Payload",
      "type": "n8n-nodes-base.set",
      "position": [860, 420],
      "typeVersion": 3.4,
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "al1",
              "name": "subject",
              "value": "=🚨 Momentis DOWN — {{ $now.toISO() }}",
              "type": "string"
            },
            {
              "id": "al2",
              "name": "body",
              "value": "=Health check FAILED at {{ $now.toISO() }}.\n\nResponse received: {{ JSON.stringify($json) }}\n\nCheck manually: https://YOUR_APP.vercel.app/api/health",
              "type": "string"
            },
            {
              "id": "al3",
              "name": "to",
              "value": "ofek.karavani1@gmail.com",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "send-email",
      "name": "Send Alert Email",
      "type": "n8n-nodes-base.emailSend",
      "position": [1080, 420],
      "typeVersion": 2.1,
      "onError": "continueRegularOutput",
      "parameters": {
        "fromEmail": "alerts@momentis.app",
        "toEmail": "={{ $json.to }}",
        "subject": "={{ $json.subject }}",
        "text": "={{ $json.body }}"
      }
    }
  ],
  "connections": {
    "Every 15 Min": {
      "main": [[{ "node": "Health Check", "type": "main", "index": 0 }]]
    },
    "Health Check": {
      "main": [[{ "node": "Is Healthy?", "type": "main", "index": 0 }]]
    },
    "Is Healthy?": {
      "main": [
        [{ "node": "All Good ✅", "type": "main", "index": 0 }],
        [{ "node": "Build Alert Payload", "type": "main", "index": 0 }]
      ]
    },
    "Build Alert Payload": {
      "main": [[{ "node": "Send Alert Email", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" }
}
